# Dotfiles and dot-folders (.venv/, .profiles/, .pytest_cache/, .superpowers/, .env*, ...)
.*
!.gitignore
!.gitattributes
!.env.example

# Local state: your settings (copy of configs.json.example) and data/ (catalog, saved library
# paths, Copilot browser profile, pytest cache)
configs.json
data/

# Build output
dist/
build/
*.egg-info/
*.zip

# Dependencies and Python caches
venv/
__pycache__/
*.py[cod]

# Secrets and logs
secrets/
*.pem
*.key
*.log
