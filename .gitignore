# Dotfiles and dot-folders (.venv/, .profiles/, .pytest_cache/, .superpowers/, .env*, ...)
.*
!.gitignore
!.gitattributes
!.env.example

# Local state: catalog, your settings (copy of configs.json.example), library paths, Copilot browser profile
catalog.json
configs.json
library-source.txt
.profiles/
tmp*

# Build output
dist/
build/
*.egg-info/
*.zip

# Dependencies and Python caches
venv/
__pycache__/
*.py[cod]

# Secrets and logs
secrets/
*.pem
*.key
*.log
